{
    "name": "damoony/simplcms",
    "description": "SimplCMS — lightweight multi-domain CMS",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "classmap": [
            "../sources/",
            "../corescripts/_lib/",
            "../corescripts/commands/"
        ],
        "files": [
            "../www/constants.php",
            "../www/included.php"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "phpunit/"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": false,
        "vendor-dir": "vendor"
    },
    "scripts": {
        "test":  "phpunit --configuration phpunit.xml",
        "stan":  "phpstan --configuration phpstan.neon --no-progress",
        "check": [ "@stan", "@test" ]
    }
}