includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - ../sources
        - ../corescripts/_lib
        - ../corescripts/commands
        - ../www/admin/_lib
    scanFiles:
        - ../engine/main.php
    bootstrapFiles:
        - stubs.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false