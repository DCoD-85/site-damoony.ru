includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - ../engine
        - ../corescripts/_lib
        - ../corescripts/commands
        - ../www/admin/_lib
    scanDirectories:
        - ../visuo
        - ../visuo/sources
        - ../engines
    scanFiles:
        - ../engine/main.php
        - ../engine/constants.php
    bootstrapFiles:
        - stubs.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false