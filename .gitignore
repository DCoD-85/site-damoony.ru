# Слепки — локальные, в репозиторий не идут
_backup_*/

# Системное
Thumbs.db
.DS_Store
*.log
*.bak

# IDE
.vscode/
.idea/

# Секреты — глобально, по расширению
*.secure

# secure/ — папку держим в git, но только заглушку
secure/*
!secure/.gitkeep

# Auto-generated language file
language/save.txt.inc
audit-*.txt
config-usage.txt
const-usage.txt
data-tree.txt
media-files.txt
media-tree.txt
backupdomain/

# Media доменов — генерируется через domain:new
www/media/*/
!www/media/shared/
!www/media/damoony.ru/

# Language доменов: авто-дефолты не коммитим
language/domains/*/save.txt.inc
*.Разбор проекта*.md
secure/admin_fails.json
_dev/*.txt
_dev/.phpunit.cache/

# Секреты и локальные конфиги
config/site.config
config/site.config.lock
_backup/
_tmp/
_backup/
_tmp/
_dev/bin/.phpunit.result.cache
.phpunit.cache/
