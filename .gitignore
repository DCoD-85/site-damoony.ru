# ================= СЕКРЕТЫ =================
# config: доступы к БД и админке
config/site.config
config/site.config.bak
config/site.config.lock
config/admin.config
config/*.bak
config/*.lock
config_backup_*/

# secure: всё, кроме явных заглушек
secure/*
!secure/.gitkeep
!secure/index.php
!secure/db.secure.example
!secure/blacklist/blacklist.txt
!secure/blacklist/index.php
!secure/blacklist/whitelist.txt
*.secure
!*.secure.example

# ================= МУСОР / СЛУЖЕБНОЕ =================
.vscode/
.idea/
*.log
*.bak
Thumbs.db
.DS_Store
_backup/
_tmp/
_dev/bin/.phpunit.result.cache
_dev/.phpunit.cache/
_dev/vendor/
_dev/composer.lock
.phpunit.cache/

