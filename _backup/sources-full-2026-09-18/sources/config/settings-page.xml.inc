<?xml version="1.0" encoding="UTF-8" ?>
<settings>
	<row>
		<name>use-type</name>
		<value>header</value>
		<comment>тип вывода [ header | content-type ]</comment>
	</row>
	<row>
		<name>doc-type</name>
		<value>text/html</value>
		<comment>тип документа</comment>
	</row>
	<row>
		<name>doc-lang-charset</name>
		<value>UTF-8</value>
		<comment></comment>
	</row>
	<row>
		<name>doc-lang-charset-from</name>
		<value>windows-1251</value>
		<comment>Кодировка из которой переводим</comment>
	</row>
	<row>
		<name>doc-lang-charset-to</name>
		<value>UTF-8</value>
		<comment>Кодировка, в которую переводим</comment>
	</row>
	
	
	
